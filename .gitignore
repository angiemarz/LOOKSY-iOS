# Xcode project is generated by XcodeGen (project.yml is the source of truth)
*.xcodeproj/
*.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
LOOKSY/Resources/Info.plist

# Build output
build/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM
*.xcresult
*.xcarchive

# Xcode user data
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Signing material and secrets — NEVER commit these
*.p12
*.cer
*.mobileprovision
*.provisionprofile
*.keychain
*.pem
*.key
.env
.env.*
secrets/

# Personal data — LOOKSY backups and photos must never reach GitHub
*.looksybackup
LOOKSY-respaldo-*.json
personal/
photos/
backups/

# OS / editors
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
